rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Profile document: written by the browser on sign-up and from profile settings
      allow read, write: if isOwner(uid);

      // Tasks hold scores, so only the API (Admin SDK, which bypasses these rules)
      // may write them. The browser can read its own tasks.
      match /tasks/{taskId} {
        allow read: if isOwner(uid);
      }

      // Settings (e.g. target band) are written through /api/reports/target
      match /settings/{settingId} {
        allow read: if isOwner(uid);
      }
    }

    // Everything else is denied by default.
  }
}
